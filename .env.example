# Optional shared key protecting all /api routes. Demo binds to loopback by default.
KNOWLEDGE_GATEWAY_API_KEY=
# Select config.yaml for configured services; run.sh defaults to config.demo.yaml.
KNOWLEDGE_GATEWAY_CONFIG=config.demo.yaml
OPENROUTER_API_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Optional launch overrides (configuration supplies defaults).
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_RELOAD=0
