# Knowledge Gateway Environment Configuration
# Copy this to .env and fill in your keys

# Embedding API Configuration (OpenAI or OpenRouter compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=weftkit_knowledge_rag

# Relational Database (PostgreSQL / WeftKit)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=weftkit_admin
POSTGRES_PASSWORD=weftkit_secret
POSTGRES_DB=weftkit_db

# Gateway Server Settings
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
